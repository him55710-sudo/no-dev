{
  "name": "pureobom",
  "version": "0.7.0",
  "description": "Explore software structure, edit source-linked designs, and review implementation and verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/him55710-sudo/no-dev.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "bench": "vitest run tests/performance.test.ts",
    "extension:build": "tsc -p extension/tsconfig.json && node scripts/build-extension.mjs",
    "extension:test": "node scripts/test-extension.mjs",
    "extension:design-test": "node scripts/test-design-workspace.mjs",
    "extension:design-ui-test": "node scripts/test-installed-design-ui.mjs",
    "extension:recovery-test": "node scripts/test-installed-recovery.mjs",
    "agent:connection": "node scripts/check-agent-connection.mjs",
    "agent:live-test": "node scripts/test-live-design.mjs",
    "extension:test:installed": "node scripts/test-extension.mjs --installed",
    "extension:package": "node scripts/package-extension.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "demo:record": "node scripts/build-system-demo.mjs",
    "study:package": "node scripts/package-user-study.mjs",
    "pages:package": "node scripts/package-pages.mjs",
    "pages:preview": "node scripts/serve.mjs --site",
    "verify": "pnpm test && pnpm build && pnpm extension:build && pnpm extension:test",
    "format": "prettier --write src tests docs *.json *.ts *.html",
    "extension:project-live-test": "node scripts/test-project-reader.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.12.0",
    "css-tree": "3.2.1",
    "jsonc-parser": "3.3.1",
    "jszip": "3.10.1",
    "parse5": "8.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sqlite3-parser": "0.7.1",
    "typescript": "5.9.3",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/vscode": "1.96.0",
    "@vitejs/plugin-react": "5.1.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
